@model JobFinder.Models.Job

@{
    ViewData["Title"] = "Add Job";

    var companyName = ViewData["CompanyName"] as string ?? "";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-xl-9 col-lg-10">

            <div class="mb-4">

                <p class="text-uppercase small fw-semibold mb-2">
                    Job Management
                </p>

                <h1 class="display-5 fw-bold mb-2">
                    Add a Job
                </h1>

                <p class="text-muted mb-0">
                    Create a job listing and associate it with a company.
                </p>

            </div>

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4 p-lg-5">

                    <form asp-controller="Jobs"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="All"
                             class="alert alert-danger"
                             role="alert">
                        </div>

                        <!-- Job Title -->
                        <div class="mb-4">

                            <label asp-for="Title"
                                   class="form-label fw-semibold">
                                Job Title
                            </label>

                            <input asp-for="Title"
                                   class="form-control form-control-lg"
                                   placeholder="e.g. Software Developer" />

                            <span asp-validation-for="Title"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Company -->
                        <div class="mb-4">

                            <label for="companyName"
                                   class="form-label fw-semibold">
                                Company
                            </label>

                            <input type="text"
                                   id="companyName"
                                   name="companyName"
                                   value="@companyName"
                                   class="form-control form-control-lg"
                                   placeholder="e.g. Microsoft"
                                   autocomplete="organization" />

                            <div class="form-text">
                                Enter an existing company or a new company name.
                                A new company will be created automatically.
                            </div>

                            @if (ViewData.ModelState["CompanyName"]?.Errors.Count > 0)
                            {
                                <span class="text-danger">
                                    @ViewData.ModelState["CompanyName"]?.Errors[0].ErrorMessage
                                </span>
                            }

                        </div>

                        <!-- Description -->
                        <div class="mb-4">

                            <label asp-for="Description"
                                   class="form-label fw-semibold">
                                Description
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="8"
                                      placeholder="Enter the job description..."></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Location -->
                        <div class="mb-4">

                            <label asp-for="Location"
                                   class="form-label fw-semibold">
                                Location
                            </label>

                            <input asp-for="Location"
                                   class="form-control"
                                   placeholder="e.g. Johannesburg, Gauteng" />

                            <span asp-validation-for="Location"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Employment Type -->
                        <div class="mb-4">

                            <label asp-for="EmploymentType"
                                   class="form-label fw-semibold">
                                Employment Type
                            </label>

                            <select asp-for="EmploymentType"
                                    class="form-select">

                                <option value="">
                                    Select employment type
                                </option>

                                <option value="Full-time">
                                    Full-time
                                </option>

                                <option value="Part-time">
                                    Part-time
                                </option>

                                <option value="Contract">
                                    Contract
                                </option>

                                <option value="Internship">
                                    Internship
                                </option>

                            </select>

                            <span asp-validation-for="EmploymentType"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Salary -->
                        <div class="row">

                            <div class="col-md-6 mb-4">

                                <label asp-for="SalaryMin"
                                       class="form-label fw-semibold">
                                    Minimum Salary
                                </label>

                                <input asp-for="SalaryMin"
                                       class="form-control"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       placeholder="e.g. 15000" />

                                <span asp-validation-for="SalaryMin"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6 mb-4">

                                <label asp-for="SalaryMax"
                                       class="form-label fw-semibold">
                                    Maximum Salary
                                </label>

                                <input asp-for="SalaryMax"
                                       class="form-control"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       placeholder="e.g. 25000" />

                                <span asp-validation-for="SalaryMax"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                        <!-- Dates -->
                        <div class="row">

                            <div class="col-md-6 mb-4">

                                <label asp-for="PostedDate"
                                       class="form-label fw-semibold">
                                    Posted Date
                                </label>

                                <input asp-for="PostedDate"
                                       class="form-control"
                                       type="date" />

                                <span asp-validation-for="PostedDate"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6 mb-4">

                                <label asp-for="ClosingDate"
                                       class="form-label fw-semibold">
                                    Closing Date
                                </label>

                                <input asp-for="ClosingDate"
                                       class="form-control"
                                       type="date" />

                                <span asp-validation-for="ClosingDate"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                        <!-- Source -->
                        <div class="mb-4">

                            <label asp-for="Source"
                                   class="form-label fw-semibold">
                                Source
                            </label>

                            <input asp-for="Source"
                                   class="form-control"
                                   placeholder="e.g. PNet, LinkedIn, Company Website" />

                            <span asp-validation-for="Source"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Source URL -->
                        <div class="mb-4">

                            <label asp-for="SourceUrl"
                                   class="form-label fw-semibold">
                                Source URL
                            </label>

                            <input asp-for="SourceUrl"
                                   class="form-control"
                                   type="url"
                                   placeholder="https://..." />

                            <span asp-validation-for="SourceUrl"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- CompanyId is deliberately NOT shown.
                             It is assigned automatically by JobService. -->

                        <div class="d-flex flex-wrap gap-2 pt-2">

                            <button type="submit"
                                    class="btn btn-primary px-4">
                                Add Job
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary px-4">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}