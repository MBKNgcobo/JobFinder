@model List<JobFinder.Models.DTOs.JobRecommendationDto>

@{
    ViewData["Title"] = "Recommended Jobs";
}

<div class="container mt-4">

    <h1>Recommended Jobs</h1>

    <p class="text-muted">
        Jobs matched against your skills and preferences.
    </p>

    <form method="get"
          asp-controller="Recommendations"
          asp-action="Index"
          class="mb-4">

        <div class="row">

            <div class="col-md-6">

                <input type="text"
                       name="location"
                       value="@ViewBag.Location"
                       class="form-control"
                       placeholder="Filter by location e.g. Johannesburg" />

            </div>

            <div class="col-md-2">

                <button type="submit"
                        class="btn btn-primary">

                    Search

                </button>

            </div>

        </div>

    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No matching jobs found.
        </div>
    }
    else
    {
        foreach (var job in Model)
        {
            <div class="card mb-3 shadow-sm">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <h4>
                                @job.Title
                            </h4>

                            <h6 class="text-muted">
                                @job.Company
                            </h6>

                            <p>
                                📍 @job.Location
                            </p>

                        </div>

                        <div>

                            <span class="badge bg-success fs-6">
                                @job.MatchScore.ToString("0.##")%
                                Match
                            </span>

                        </div>

                    </div>

                    <hr />

                    <h6>Matched skills</h6>

                    @if (job.MatchedRequiredSkills.Any())
                    {
                        foreach (
                        var skill
                        in job.MatchedRequiredSkills)
                        {
                            <span class="badge bg-primary me-1">
                                @skill
                            </span>
                        }
                    }
                    else
                    {
                        <span class="text-muted">
                            No required skills matched
                        </span>
                    }

                    <h6 class="mt-3">
                        Missing required skills
                    </h6>

                    @if (job.MissingRequiredSkills.Any())
                    {
                        foreach (
                        var skill
                        in job.MissingRequiredSkills)
                        {
                            <span class="badge bg-danger me-1">
                                @skill
                            </span>
                        }
                    }
                    else
                    {
                        <span class="text-success">
                            No missing required skills
                        </span>
                    }

                    <div class="mt-4">

                        <a href="@job.SourceUrl"
                           target="_blank"
                           class="btn btn-outline-primary me-2">

                            View Job

                        </a>

                        <form method="post"
                              action="/Applications/Apply">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="jobId"
                                   value="@job.JobId" />

                            <button type="submit"
                                    class="btn btn-success">

                                Apply

                            </button>

                        </form>

                    </div>

                </div>

            </div>
        }
    }

</div>