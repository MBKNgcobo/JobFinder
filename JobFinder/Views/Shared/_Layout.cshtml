<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - JobFinder</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/JobFinder.styles.css"
          asp-append-version="true" />
</head>

<body>

    <header class="site-header">

        <div class="container">

            <nav class="jobfinder-nav">

                <a class="jobfinder-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="brand-symbol">✦</span>

                    <span>JobFinder</span>

                </a>


                <div class="jobfinder-links">
                    @{
                        var currentController =
                        ViewContext.RouteData.Values["controller"]?.ToString();
                    }

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="nav-pill @(currentController == "Home" ? "active" : "")">
                        Home
                    </a>

                    <a asp-controller="Jobs"
                       asp-action="Index"
                       class="nav-pill @(currentController == "Jobs" ? "active" : "")">
                        Jobs
                    </a>

                    <a asp-controller="Applications"
                       asp-action="Index"
                       class="nav-pill @(currentController == "Applications" ? "active" : "")">
                        Applications
                    </a>

                </div>


                <a asp-controller="Jobs"
                   asp-action="Index"
                   class="nav-cta">

                    Explore Jobs

                </a>

            </nav>

        </div>

    </header>


    <main>

        @RenderBody()

    </main>


    <footer class="site-footer">

        <div class="container">

            <div class="footer-inner">

                <div>
                    <strong>JobFinder</strong>
                    <span>
                        Find better. Apply smarter.
                    </span>
                </div>

                <div>
                    © 2026 JobFinder
                </div>

            </div>

        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>